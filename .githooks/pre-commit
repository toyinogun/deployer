#!/bin/sh
# Format, vet, lint, and build before a commit lands. Tests stay out of here on
# purpose: they will grow to need SQLite files and a fake cluster, and CI runs them.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -e

staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
[ -z "$staged_go" ] && exit 0

# gofmt rewrites in place, so re-stage whatever it touched rather than failing you
# over whitespace you did not type.
unformatted=$(gofmt -l $staged_go)
if [ -n "$unformatted" ]; then
  echo "gofmt: reformatting $unformatted"
  gofmt -w $unformatted
  git add $unformatted
fi

go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run
else
  echo "pre-commit: golangci-lint not found, skipping it. Install with:"
  echo "  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2"
fi

go build ./...
